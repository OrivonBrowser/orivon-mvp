{
  "name": "orivon",
  "version": "0.0.0",
  "private": true,
  "description": "Orivon MVP - a browser that runs applications impossible in Chrome, under user-granted per-app capabilities",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OrivonBrowser/orivon-mvp.git"
  },
  "bugs": {
    "url": "https://github.com/OrivonBrowser/orivon-mvp/issues"
  },
  "homepage": "https://github.com/OrivonBrowser/orivon-mvp#readme",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "node scripts/build-ordinary.mjs",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check:natives": "node scripts/check-no-native-modules.mjs",
    "check:contracts": "node scripts/check-contracts-pure.mjs",
    "check:secrets": "node scripts/check-no-secrets.mjs",
    "check:vectors": "node scripts/check-vectors.mjs",
    "check:comments": "node scripts/check-comments.mjs",
    "check:size": "node scripts/check-size.mjs",
    "check:dev-grant-absent": "node scripts/check-dev-grant-absent.mjs",
    "install:electron": "node scripts/install-electron.mjs",
    "smoke": "node scripts/build-ordinary.mjs && node scripts/smoke.mjs",
    "test:e2e": "node scripts/build-e2e.mjs && vitest run --config test/vitest.e2e.config.ts",
    "package:linux": "node scripts/build-ordinary.mjs && electron-builder --linux",
    "postinstall": "node scripts/check-no-native-modules.mjs && node scripts/install-electron.mjs",
    "check:advisories": "node scripts/check-advisories.mjs"
  },
  "dependencies": {
    "browserify-zlib": "^0.2.0",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.1",
    "events": "^3.3.0",
    "os-browserify": "^0.3.0",
    "pako": "^3.0.1",
    "path-browserify": "^1.0.1",
    "stream-browserify": "^3.0.0",
    "util": "^0.12.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@swc/core": "^1.13.0",
    "@types/node": "^24.0.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "~7.3.6",
    "vitest": "^4.1.11"
  }
}
