{
  "name": "orivon",
  "version": "0.0.0",
  "private": true,
  "description": "Orivon Browser - runs applications impossible in Chrome, under user-granted per-app capabilities",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OrivonBrowser/orivon-mvp.git"
  },
  "bugs": {
    "url": "https://github.com/OrivonBrowser/orivon-mvp/issues"
  },
  "homepage": "https://github.com/OrivonBrowser/orivon-mvp#readme",
  "main": "out/main/index.js",
  "desktopName": "orivon.desktop",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build-ordinary.mjs",
    "start": "node scripts/build-ordinary.mjs && electron-vite preview --skipBuild",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p vendor/tsconfig.json",
    "test": "vitest run",
    "check:natives": "node scripts/check-no-native-modules.mjs",
    "check:contracts": "node scripts/check-contracts-pure.mjs",
    "check:secrets": "node scripts/check-no-secrets.mjs",
    "check:vectors": "node scripts/check-vectors.mjs",
    "check:comments": "node scripts/check-comments.mjs",
    "check:size": "node scripts/check-size.mjs",
    "check:questions": "node scripts/check-questions.mjs",
    "check:manifest-parity": "node scripts/check-manifest-parity.mjs",
    "check:page-globals": "node scripts/check-page-globals.mjs",
    "check:native-dialogs": "node scripts/check-native-dialogs.mjs",
    "check:dev-grant-absent": "node scripts/check-dev-grant-absent.mjs",
    "check:devlog": "node scripts/check-devlog.mjs",
    "check:app-behaviours": "node scripts/app-behaviours/check-app-behaviours.mjs",
    "check:contracts-surface": "node scripts/app-behaviours/check-contracts-surface.mjs",
    "check:test-paths": "node scripts/check-test-paths.mjs",
    "check:impact-map": "node scripts/ci/check-impact-map.mjs",
    "install:electron": "node scripts/install-electron.mjs",
    "smoke": "node scripts/build-ordinary.mjs && node scripts/run-headless.mjs node scripts/smoke.mjs",
    "test:e2e": "node scripts/build-e2e.mjs && node scripts/run-headless.mjs npx vitest run --config test/vitest.e2e.config.ts",
    "qa": "node scripts/qa.mjs all",
    "qa:visual": "node scripts/qa.mjs visual",
    "qa:report": "node scripts/qa-report.mjs",
    "perf:probe": "node scripts/perf-probe.mjs",
    "package:linux": "node scripts/build-ordinary.mjs && electron-builder --linux --publish never",
    "package:win": "node scripts/build-ordinary.mjs && electron-builder --win --publish never",
    "package:mac": "node scripts/build-ordinary.mjs && electron-builder --mac --publish never",
    "postinstall": "node scripts/check-no-native-modules.mjs && node scripts/install-electron.mjs",
    "check:advisories": "node scripts/check-advisories.mjs"
  },
  "dependencies": {
    "@a16z/helios": "0.11.1",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@ipld/dag-pb": "^4.2.0",
    "@mozilla/readability": "0.6.0",
    "@sqlite.org/sqlite-wasm": "3.53.4-build1",
    "adm-zip": "0.6.1",
    "browserify-zlib": "^0.2.0",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.1",
    "debug": "4.4.3",
    "events": "^3.3.0",
    "ipfs-unixfs": "^13.1.2",
    "ipfs-unixfs-exporter": "^16.2.3",
    "ipns": "^11.0.1",
    "multiformats": "^14.0.5",
    "os-browserify": "^0.3.0",
    "pako": "^3.0.1",
    "path-browserify": "^1.0.1",
    "pbf": "^4.0.2",
    "qrcode-generator": "2.0.4",
    "stream-browserify": "^3.0.0",
    "tldts": "7.4.16",
    "util": "^0.12.5",
    "viem": "^2.56.8"
  },
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@libp2p/crypto": "^5.1.23",
    "@playwright/test": "^1.62.1",
    "@swc/core": "^1.13.0",
    "@types/chrome": "0.0.300",
    "@types/debug": "4.1.13",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "express": "^4.22.3",
    "ipfs-unixfs-importer": "^17.1.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "typescript": "^7.0.2",
    "vite": "~7.3.6",
    "vitest": "^4.1.11",
    "ws": "^8.22.0"
  },
  "overrides": {
    "app-builder-lib": {
      "@electron/get": "^5.1.0"
    }
  }
}
