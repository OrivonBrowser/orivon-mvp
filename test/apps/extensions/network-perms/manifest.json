{
  "manifest_version": 3,
  "name": "Orivon E2E Network Perms",
  "version": "1.0.0",
  "description": "Fixture extension for test/extensions/e2e-extensions-load.test.ts: declares every permission loadableManifest must strip.",
  "permissions": ["declarativeNetRequest", "webRequest", "nativeMessaging", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
