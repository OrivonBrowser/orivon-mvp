--- a/wasm/smolmix/src/device.rs
+++ b/wasm/smolmix/src/device.rs
@@ -100,6 +100,14 @@ impl WasmDevice {
     pub fn drain_tx(&mut self) -> impl Iterator<Item = Vec<u8>> + '_ {
         self.tx_queue.drain(..)
     }
+
+    /// Remove at most `max` outgoing IP packets from the front of the transmit queue; the rest
+    /// stay queued for the next call. (`drain_tx().take(max)` would drop the rest: dropping a
+    /// `VecDeque` drain removes the elements it did not yield.)
+    pub fn drain_tx_up_to(&mut self, max: usize) -> Vec<Vec<u8>> {
+        let count = max.min(self.tx_queue.len());
+        self.tx_queue.drain(..count).collect()
+    }
 }
 
