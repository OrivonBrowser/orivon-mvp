+// SPDX-License-Identifier: Apache-2.0
+
+//! Puts the exit's reply frames back in the order it numbered them.
+//!
+//! The exit numbers every reply frame (1, 2, 3, ...), and each frame then reaches the client by a route of its own through the
+//! mixnet, so frames arrive in an order that is far from the one they were sent in. TCP below sees that as loss: the
+//! receiver acknowledges the same byte again and again, the sender takes the repeats for lost segments, sends them a second
+//! time and slows down. Holding a frame back until the ones before it have come, for a bounded time, gives TCP the order it
+//! was sent in.
+
+use std::collections::BTreeMap;
+
+/// How long a frame may be held for one that has not come. The run goes on without it after that; the frame, if it comes
+/// later, is passed on at once.
+pub const GAP_TIMEOUT_MS: f64 = 1500.0;
+/// Most frames held at once; past it the oldest gap is given up.
+const MAX_HELD_FRAMES: usize = 512;
+/// A frame this far ahead of the one expected is a new numbering, not a frame far ahead.
+const RESTART_DISTANCE: u32 = 8192;
+
+pub struct Resequencer<T> {
+    next: u32,
+    held: BTreeMap<u32, T>,
+    /// When the oldest wait for a missing frame began.
+    waiting_since: Option<f64>,
+}
+
+impl<T> Default for Resequencer<T> {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl<T> Resequencer<T> {
+    /// The exit's run starts at 1; 0 is for control replies, which are not part of the run.
+    pub fn new() -> Self {
+        Self {
+            next: 1,
+            held: BTreeMap::new(),
+            waiting_since: None,
+        }
+    }
+
+    /// Offers the frame numbered `seq`, which arrived at `now` (milliseconds). The frames that are due go to `out`, in order.
+    pub fn push(&mut self, seq: u32, frame: T, now: f64, out: &mut Vec<T>) {
+        if seq == 0 {
+            out.push(frame);
+            return;
+        }
+        let ahead = seq.wrapping_sub(self.next);
+        if ahead == 0 {
+            out.push(frame);
+            self.next = self.next.wrapping_add(1);
+            self.release_run(out);
+            self.waiting_since = if self.held.is_empty() { None } else { Some(now) };
+        } else if ahead >= 1 << 31 {
+            // A frame whose turn was given up: TCP below copes with a late segment.
+            out.push(frame);
+        } else if ahead > RESTART_DISTANCE {
+            self.release_all(out);
+            out.push(frame);
+            self.next = seq.wrapping_add(1);
+            self.waiting_since = None;
+        } else {
+            self.held.insert(seq, frame);
+            if self.waiting_since.is_none() {
+                self.waiting_since = Some(now);
+            }
+            if self.held.len() > MAX_HELD_FRAMES {
+                self.give_up_gap(now, out);
+            }
+        }
+    }
+
+    /// Gives up the wait for a missing frame once it has lasted `GAP_TIMEOUT_MS`.
+    pub fn tick(&mut self, now: f64, out: &mut Vec<T>) {
+        if let Some(since) = self.waiting_since {
+            if now - since >= GAP_TIMEOUT_MS {
+                self.give_up_gap(now, out);
+            }
+        }
+    }
+
+    /// Whether any frame is being held.
+    pub fn is_holding(&self) -> bool {
+        !self.held.is_empty()
+    }
+
+    fn give_up_gap(&mut self, now: f64, out: &mut Vec<T>) {
+        if let Some(&first) = self.held.keys().next() {
+            self.next = first;
+            self.release_run(out);
+        }
+        self.waiting_since = if self.held.is_empty() { None } else { Some(now) };
+    }
+
+    fn release_run(&mut self, out: &mut Vec<T>) {
+        while let Some(frame) = self.held.remove(&self.next) {
+            out.push(frame);
+            self.next = self.next.wrapping_add(1);
+        }
+    }
+
+    fn release_all(&mut self, out: &mut Vec<T>) {
+        out.extend(std::mem::take(&mut self.held).into_values());
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn pushed(r: &mut Resequencer<u32>, seq: u32, now: f64) -> Vec<u32> {
+        let mut out = Vec::new();
+        r.push(seq, seq, now, &mut out);
+        out
+    }
+
+    #[test]
+    fn frames_in_order_pass_straight_through() {
+        let mut r = Resequencer::new();
+        assert_eq!(pushed(&mut r, 1, 0.0), vec![1]);
+        assert_eq!(pushed(&mut r, 2, 1.0), vec![2]);
+        assert!(!r.is_holding());
+    }
+
+    #[test]
+    fn a_frame_ahead_waits_for_the_one_before_it() {
+        let mut r = Resequencer::new();
+        assert_eq!(pushed(&mut r, 3, 0.0), Vec::<u32>::new());
+        assert_eq!(pushed(&mut r, 2, 1.0), Vec::<u32>::new());
+        assert_eq!(pushed(&mut r, 1, 2.0), vec![1, 2, 3]);
+        assert!(!r.is_holding());
+    }
+
+    #[test]
+    fn the_wait_for_a_missing_frame_ends_and_the_late_frame_is_passed_on_at_once() {
+        let mut r = Resequencer::new();
+        assert_eq!(pushed(&mut r, 2, 0.0), Vec::<u32>::new());
+        let mut out = Vec::new();
+        r.tick(GAP_TIMEOUT_MS - 1.0, &mut out);
+        assert!(out.is_empty());
+        r.tick(GAP_TIMEOUT_MS, &mut out);
+        assert_eq!(out, vec![2]);
+        assert_eq!(pushed(&mut r, 1, GAP_TIMEOUT_MS + 5.0), vec![1]);
+        assert_eq!(pushed(&mut r, 3, GAP_TIMEOUT_MS + 6.0), vec![3]);
+    }
+
+    #[test]
+    fn control_replies_numbered_zero_are_not_held() {
+        let mut r = Resequencer::new();
+        assert_eq!(pushed(&mut r, 0, 0.0), vec![0]);
+        assert_eq!(pushed(&mut r, 1, 1.0), vec![1]);
+    }
+
+    #[test]
+    fn too_many_held_frames_give_up_the_oldest_gap() {
+        let mut r = Resequencer::new();
+        let mut released = Vec::new();
+        for seq in 2..=(MAX_HELD_FRAMES as u32 + 2) {
+            r.push(seq, seq, 0.0, &mut released);
+        }
+        assert_eq!(released.len(), MAX_HELD_FRAMES + 1);
+        assert_eq!(released[0], 2);
+        assert!(!r.is_holding());
+    }
+
+    #[test]
+    fn a_far_jump_is_a_new_numbering() {
+        let mut r = Resequencer::new();
+        assert_eq!(pushed(&mut r, 2, 0.0), Vec::<u32>::new());
+        let mut out = Vec::new();
+        r.push(RESTART_DISTANCE + 100, RESTART_DISTANCE + 100, 1.0, &mut out);
+        assert_eq!(out, vec![2, RESTART_DISTANCE + 100]);
+        assert_eq!(pushed(&mut r, RESTART_DISTANCE + 101, 2.0), vec![RESTART_DISTANCE + 101]);
+    }
+
+    #[test]
+    fn numbering_wraps() {
+        let mut r = Resequencer::new();
+        r.next = u32::MAX;
+        assert_eq!(pushed(&mut r, 0, 0.0), vec![0]);
+        assert_eq!(pushed(&mut r, 1, 0.0), Vec::<u32>::new());
+        assert_eq!(pushed(&mut r, u32::MAX, 0.0), vec![u32::MAX]);
+    }
+}
