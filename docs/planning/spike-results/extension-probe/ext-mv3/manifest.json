{
  "manifest_version": 3, "name": "probe-mv3", "version": "1.0",
  "permissions": ["scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "bg.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["iso.js"], "run_at": "document_start" },
    { "matches": ["<all_urls>"], "js": ["main.js"], "run_at": "document_start", "world": "MAIN" }
  ],
  "web_accessible_resources": [{ "resources": ["war.js"], "matches": ["<all_urls>"] }]
}
